---
import { getCollection } from "astro:content";
import InkPaperBackground from "../components/InkPaperBackground.astro";
import TableOfContents, { type TocGroup } from "../components/TableOfContents.astro";

interface Props {
  title: string;
  noIndex?: boolean;
  bodyClass?: string;
  description?: string;
  toc?: TocGroup[];
}
const {
  title,
  bodyClass,
  description,
  noIndex = false,
  toc = [{ items: [{ label: "Overview", href: "#page-main" }] }],
} = Astro.props;
const siteTitle = "Technical Scratches";
const siteDescription =
  "Thoughts on software engineering and life as a developer";
const siteUrl = "https://blog.danmarshall.dev";
const owner = "Dan Marshall";
const currentYear = new Date().getFullYear();

const navArticles = (await getCollection("articles", ({ data }) => !data.unlisted)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const isArticlePage =
  bodyClass?.split(/\s+/).includes("article-detail") ?? false;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? siteDescription} />
    {noIndex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      href={`${siteUrl}/feed.xml`}
      type="application/rss+xml"
      title={siteDescription}
    />
    <link rel="stylesheet" href="/styles/fonts.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body class={`ink-site ${bodyClass ?? ""}`}>
    <div class="page-scene" aria-hidden="true">
      <InkPaperBackground />
    </div>

    <!-- Mobile hamburger — hidden on desktop -->
    <button
      class="hamburger"
      id="hamburger"
      onclick="openDrawer()"
      aria-label="Open menu"
      aria-controls="drawer"
      aria-expanded="false"
      data-tooltip="Open site menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Mobile drawer -->
    <div class="drawer-overlay" id="drawer-overlay" onclick="closeDrawer()">
    </div>
    <aside class="drawer" id="drawer" inert>
      <div class="drawer-header">
        <button
          class="drawer-close"
          id="drawer-close"
          onclick="closeDrawer()"
          aria-label="Close"
          data-tooltip="Close the menu">✕</button
        >
      </div>
      <div class="drawer-body" id="drawer-body">
        <nav class="drawer-primary-nav" aria-label="Primary navigation">
          <div class="drawer-nav-title">Elsewhere</div>
          <a href="/" data-tooltip="Back to the homepage">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 9 12 2l9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>
            <span>Home</span>
          </a>
          <a href="/" data-tooltip="Latest writing and featured posts">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19.5V5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5"/><path d="M8 7h8"/><path d="M8 11h7"/></svg>
            <span>Writing</span>
          </a>
          <a href="/topics/" data-tooltip="Browse articles by topic">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.59 13.41 12 22l-8.59-8.59A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.41.59l7.18 7.18a2 2 0 0 1 0 2.64Z"/><path d="M7.5 7.5h.01"/></svg>
            <span>Topics</span>
          </a>
          <a href="/archive/" data-tooltip="Browse every article">
            <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/></svg>
            <span>Archive</span>
          </a>
          <a href="/articles/resume/" data-tooltip="Read my current resume"
            ><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 3H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Z"/><path d="M9 8h6"/><path d="M9 12h6"/><path d="M9 16h3"/></svg>
            <span>Resume</span></a
          >
          <a
            href="mailto:danmarshall909@gmail.com"
            data-tooltip="Send me an email">
            <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>Email Dan</span></a
          >
          <a
            href="https://www.linkedin.com/in/developerdan/"
            data-tooltip="View my LinkedIn profile">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            <span>LinkedIn</span></a
          >
          <a
            href="https://github.com/DanMarshall909"
            data-tooltip="View my GitHub profile">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.5 2-5-2-7-2"/></svg>
            <span>GitHub</span></a
          >
          <a href="/feed.xml" data-tooltip="Subscribe to the RSS feed">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            <span>RSS</span>
          </a>
          <button
            class="drawer-print-button"
            type="button"
            onclick="window.print()"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            <span>Save PDF</span>
          </button>
        </nav>
        {
          !isArticlePage && (
            <nav class="drawer-article-nav">
              <div class="drawer-nav-title">Articles</div>
              <ul>
                {navArticles.map((a) => {
                  const slug = a.id.replace(/\/index$/, "");
                  return (
                    <li>
                      <a href={`/articles/${slug}/`}>{a.data.title}</a>
                      <span class="drawer-nav-date">
                        {a.data.date.toLocaleDateString("en-AU", {
                          year: "numeric",
                          month: "short",
                          timeZone: "UTC",
                        })}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }
      </div>
    </aside>

    <header class="header" data-home-link="/">
      <div class="content-wrap site-shell">
        <div class="header-content-group">
          <div class="site-brand">
            <a href="/">{siteTitle}</a>
          </div>
          <nav class="site-nav" aria-label="Primary navigation">
            <a href="/" data-tooltip="Latest writing and featured posts"
              >Writing</a
            >
            <a href="/topics/" data-tooltip="Browse articles by topic">Topics</a>
            <a href="/archive/" data-tooltip="Browse every article">Archive</a>
            <a href="/articles/resume/" data-tooltip="Read my current resume"
              >Resume</a
            >
            <a href="/feed.xml" data-tooltip="Subscribe to the RSS feed">RSS</a>
            <a
              href="mailto:danmarshall909@gmail.com"
              data-tooltip="Send me an email">Contact</a
            >
          </nav>

        </div>
      </div>
    </header>

    <main id="content">
      <div class="content-wrap site-shell">
        <div class="page-pane" id="page-pane">
          <TableOfContents groups={toc} />
          <div class="page-main" id="page-main"><slot /></div>
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="content-wrap site-shell">
        <section class="copy">
          <p>&copy; {currentYear} {owner}</p>
        </section>
      </div>
    </footer>

    <script is:inline>
      // Drawer
      function openDrawer() {
        document.getElementById("drawer").classList.add("drawer-open");
        document.getElementById("drawer").removeAttribute("inert");
        document
          .getElementById("drawer-overlay")
          .classList.add("drawer-overlay-visible");
        var hamburger = document.getElementById("hamburger");
        hamburger.classList.remove("hamburger-idle");
        hamburger.setAttribute("aria-expanded", "true");
      }

      function closeDrawer() {
        document.getElementById("drawer").classList.remove("drawer-open");
        document.getElementById("drawer").setAttribute("inert", "");
        document
          .getElementById("drawer-overlay")
          .classList.remove("drawer-overlay-visible");
        var hamburger = document.getElementById("hamburger");
        hamburger.setAttribute("aria-expanded", "false");
        window.dispatchEvent(new Event("hamburger-active"));
      }

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeDrawer();
      });

      (function () {
        var hamburger = document.getElementById("hamburger");
        if (!hamburger) return;

        var idleTimer;
        var idleDelay = 1800;

        function isDrawerOpen() {
          return hamburger.getAttribute("aria-expanded") === "true";
        }

        function showHamburger() {
          hamburger.classList.remove("hamburger-idle");
          window.clearTimeout(idleTimer);
          if (isDrawerOpen()) return;
          idleTimer = window.setTimeout(function () {
            if (!isDrawerOpen()) hamburger.classList.add("hamburger-idle");
          }, idleDelay);
        }

        ["scroll", "resize", "pointermove", "touchstart", "keydown", "hamburger-active"].forEach(
          function (eventName) {
            window.addEventListener(eventName, showHamburger, { passive: true });
          },
        );

        hamburger.addEventListener("focus", showHamburger);
        hamburger.addEventListener("mouseenter", showHamburger);
        showHamburger();
      })();

      // Disclose long article code blocks and expand them for printing.
      (function () {
        if (!document.body.classList.contains("article-detail")) return;

        var content = document.querySelector("section.content");
        if (!content) return;

        var longCodeBlocks = [];
        var longCodeThreshold = 50;

        function getCodeLineCount(pre) {
          var shikiLines = pre.querySelectorAll(".line");
          if (shikiLines.length) return shikiLines.length;

          var text = pre.textContent || "";
          var lines = text.split(/\r\n|\r|\n/);
          if (lines.length > 1 && lines[lines.length - 1] === "") lines.pop();
          return lines.length;
        }

        function setCodeToggleLabel(summary, details) {
          var lines = details.getAttribute("data-code-lines");
          summary.textContent =
            (details.open ? "Hide code" : "Show code") +
            " (" +
            lines +
            " lines)";
        }

        content.querySelectorAll("pre").forEach(function (pre) {
          if (pre.closest(".code-disclosure")) return;

          var lineCount = getCodeLineCount(pre);
          if (lineCount <= longCodeThreshold) return;

          var details = document.createElement("details");
          details.className = "code-disclosure";
          details.setAttribute("data-code-lines", String(lineCount));

          var summary = document.createElement("summary");
          summary.className = "code-disclosure-summary";
          details.appendChild(summary);

          pre.parentNode.insertBefore(details, pre);
          details.appendChild(pre);
          setCodeToggleLabel(summary, details);

          details.addEventListener("toggle", function () {
            setCodeToggleLabel(summary, details);
          });

          longCodeBlocks.push(details);
        });

        if (longCodeBlocks.length) {
          var printOpenedBlocks = [];
          window.addEventListener("beforeprint", function () {
            printOpenedBlocks = longCodeBlocks.filter(function (details) {
              return !details.open;
            });
            printOpenedBlocks.forEach(function (details) {
              details.open = true;
            });
          });
          window.addEventListener("afterprint", function () {
            printOpenedBlocks.forEach(function (details) {
              details.open = false;
            });
            printOpenedBlocks = [];
          });
        }

      })();
    </script>
    <script is:inline>
      (function () {
        const header = document.querySelector(".header[data-home-link]");
        if (!(header instanceof HTMLElement)) return;

        header.addEventListener("click", function (event) {
          if (!(event.target instanceof Element)) return;
          if (
            event.target.closest(
              'a, button, input, select, textarea, summary, [role="button"]',
            )
          )
            return;

          const href = header.dataset.homeLink || "/";
          if (window.location.pathname === href) return;
          window.location.href = href;
        });
      })();
    </script>
    <script is:inline>
      (function () {
        const preferenceCookie = "code-wrap";

        function createToggleButton(className, label, icon) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = `code-toggle ${className}`;
          button.setAttribute("aria-label", label);
          button.innerHTML = icon;
          return button;
        }

        function createWrapToggle(pre, onToggle) {
          const iconMarkup = `
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false" role="img">
              <path d="M5 7h14" />
              <path d="M5 12h11c1 0 3 .5 3 2.5S17.333 17 16.5 17H12" />
              <path d="M5 17h4" />
              <path d="M15 17l2-2" />
              <path d="M15 17l2 2" />
            </svg>
          `;
          const button = createToggleButton(
            "code-wrap-toggle",
            "Toggle code wrapping",
            iconMarkup,
          );
          button.addEventListener("click", onToggle);
          pre.appendChild(button);
        }

        function readWrapPreference() {
          const prefix = preferenceCookie + "=";
          const setting = document.cookie
            .split("; ")
            .find(function (cookie) {
              return cookie.startsWith(prefix);
            });

          return setting ? setting.slice(prefix.length) !== "off" : true;
        }

        function saveWrapPreference(isWrapped) {
          document.cookie =
            preferenceCookie +
            "=" +
            (isWrapped ? "on" : "off") +
            "; Max-Age=31536000; Path=/; SameSite=Lax";
        }

        function applyWrapPreference(codeBlocks, isWrapped) {
          codeBlocks.forEach(function (pre) {
            pre.classList.toggle("wrap-enabled", isWrapped);
            const button = pre.querySelector(".code-wrap-toggle");
            if (button) {
              button.setAttribute(
                "aria-label",
                isWrapped ? "Disable code wrapping" : "Enable code wrapping",
              );
            }
          });
        }

        function initCodeWrapToggles() {
          const codeBlocks = Array.from(
            document.querySelectorAll("article.article pre"),
          );
          let isWrapped = readWrapPreference();

          codeBlocks.forEach(function (pre) {
            createWrapToggle(pre, function () {
              isWrapped = !isWrapped;
              saveWrapPreference(isWrapped);
              applyWrapPreference(codeBlocks, isWrapped);
            });
          });

          applyWrapPreference(codeBlocks, isWrapped);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initCodeWrapToggles);
        } else {
          initCodeWrapToggles();
        }
      })();
    </script>
  </body>
</html>

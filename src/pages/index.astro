---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.unlisted);
const resumeArticle = allArticles.find(a => a.id.replace(/\/index$/, '') === 'resume');
const articles = allArticles
  .filter(a => !['resume', 'resume-brief'].includes(a.id.replace(/\/index$/, '')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featuredArticle, ...recentArticles] = articles;
const toc = [{ items: [
  ...(featuredArticle ? [{ label: 'Featured article', href: '#featured-title' }] : []),
  ...(resumeArticle ? [{ label: 'Resume', href: '#resume-card' }] : []),
  { label: 'Articles', href: '#recent-title' },
] }];
---
<Layout title="Technical Scratches" bodyClass="home-page" toc={toc}>
  <section class="featured-writing" aria-labelledby="featured-title">
    <h2 id="featured-title" class="sr-only">Featured writing</h2>
    <p class="eyebrow">Featured article</p>
    <div class="featured-card-row">
      {featuredArticle && <ArticleCard article={featuredArticle} featured />}
      {resumeArticle && <div id="resume-card"><ArticleCard article={resumeArticle} featured /></div>}
    </div>
  </section>
  <section class="recent-writing" aria-labelledby="recent-title">
    <header class="section-heading">
      <p class="eyebrow">Recent writing</p>
      <h2 id="recent-title">Articles</h2>
    </header>
    <div class="article-list">{recentArticles.map(article => <ArticleCard article={article} showDescription />)}</div>
  </section>
</Layout>

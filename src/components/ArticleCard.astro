---
import type { CollectionEntry } from 'astro:content';
import { getArticleSlug, formatDate } from '../utils/article';
import { tagSlug } from '../utils/tags';
interface Props {
  article: CollectionEntry<'articles'>;
  featured?: boolean;
  showDescription?: boolean;
}
const { article, featured = false, showDescription = featured } = Astro.props;
const { title, date, tags, description } = article.data;
---
<article class:list={['article-card', { 'featured-card': featured }]} data-topic-tags={tags.map(tagSlug).join(' ')}>
  <a class="article-card-link" href={`/articles/${getArticleSlug(article.id)}/`} aria-label={`Read ${title}`}>
    <h3>{title}</h3>
    <div class="article-card-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span>{tags.slice(0, 3).join(' · ')}</span>
    </div>
    {showDescription && <p class="article-card-description">{description}</p>}
  </a>
</article>

<script is:inline>
  (async function () {
    const diagrams = document.querySelectorAll(
      'article.article pre[data-language="mermaid"] > code',
    );
    if (!diagrams.length) return;

    const { default: mermaid } = await import(
      'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
    );

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      theme: 'base',
      themeVariables: {
        background: 'transparent',
        primaryColor: 'transparent',
        primaryBorderColor: '#b8b2ac',
        primaryTextColor: '#e8e6e3',
        secondaryColor: 'transparent',
        secondaryBorderColor: '#b8b2ac',
        secondaryTextColor: '#e8e6e3',
        tertiaryColor: 'transparent',
        tertiaryBorderColor: '#b8b2ac',
        tertiaryTextColor: '#e8e6e3',
        clusterBkg: 'transparent',
        clusterBorder: '#b8b2ac',
        lineColor: '#b8b2ac',
        edgeLabelBackground: 'transparent',
        fontFamily: 'inherit',
      },
      flowchart: { useMaxWidth: true, htmlLabels: true },
    });

    const containers = [];
    diagrams.forEach(function (code) {
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      container.textContent = code.textContent || '';
      code.parentElement.replaceWith(container);
      containers.push(container);
    });

    await mermaid.run({ nodes: containers });
  })();
</script>

<style is:global>
  .mermaid-diagram {
    margin: 1.75rem 0;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .mermaid-diagram::-webkit-scrollbar {
    display: none;
  }

  .mermaid-diagram svg {
    display: block;
    min-width: 38rem;
    max-width: 100%;
    margin: 0 auto;
  }

  .mermaid-diagram svg .node rect,
  .mermaid-diagram svg .node polygon,
  .mermaid-diagram svg .node circle,
  .mermaid-diagram svg .cluster rect {
    fill: transparent !important;
  }

  .mermaid-diagram svg .nodeLabel,
  .mermaid-diagram svg .edgeLabel,
  .mermaid-diagram svg .cluster-label {
    color: #e8e6e3;
  }

  .mermaid-diagram svg .labelBkg,
  .mermaid-diagram svg .edgeLabel p {
    background: transparent !important;
  }

  @media print {
    .mermaid-diagram svg .nodeLabel,
    .mermaid-diagram svg .edgeLabel,
    .mermaid-diagram svg .cluster-label {
      color: #1f2937 !important;
    }

    .mermaid-diagram svg .flowchart-link,
    .mermaid-diagram svg .node :is(rect, polygon, circle),
    .mermaid-diagram svg .cluster rect {
      stroke: #4b5563 !important;
    }

    .mermaid-diagram svg .marker path {
      fill: #4b5563 !important;
      stroke: #4b5563 !important;
    }
  }

  @media (max-width: 48rem) {
    .mermaid-diagram svg {
      min-width: 32rem;
    }
  }
</style>

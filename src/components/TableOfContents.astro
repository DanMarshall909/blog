---
export interface TocGroup {
  title?: string;
  items: { label: string; href: string; depth?: number; count?: number }[];
}
interface Props { groups: TocGroup[] }
const { groups } = Astro.props;
---
<nav class="toc" id="page-toc" aria-label="Table of contents">
  <div class="toc-socials">
    <a href="mailto:danmarshall909@gmail.com" aria-label="Email"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
    <a href="https://www.linkedin.com/in/developerdan/" aria-label="LinkedIn"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
    <a href="https://github.com/DanMarshall909" aria-label="GitHub"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.5 2-5-2-7-2"/></svg></a>
    <a href="/feed.xml" aria-label="RSS"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg></a>
  </div>
  <p class="toc-title">On this page</p>
  {groups.map(group => (
    <section class="toc-group">
      {group.title && <p class="toc-title">{group.title}</p>}
      <ul class="toc-list">
        {group.items.map(item => (
          <li class:list={['toc-item', { 'toc-h3': item.depth === 3 }]}>
            <a class="toc-link" href={item.href}>{item.label}{item.count !== undefined && <span class="toc-count">({item.count})</span>}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</nav>

<script>
  const toc = document.getElementById('page-toc')!;
  const pane = document.getElementById('page-pane')!;
  const drawer = document.getElementById('drawer-body')!;
  const mobile = matchMedia('(max-width: 900px)');
  const closeDrawer = () => document.getElementById('drawer-close')?.click();
  function placeToc() {
    (mobile.matches ? drawer : pane).prepend(toc);
    if (!mobile.matches) closeDrawer();
  }
  mobile.addEventListener('change', placeToc);
  placeToc();

  const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('.toc-link[href^="#"]'));
  const targets = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
  function highlight() {
    let active = 0;
    const edge = parseFloat(getComputedStyle(toc).top);
    targets.forEach((target, index) => {
      if (target && target.getBoundingClientRect().top <= edge + 1) active = index;
    });
    links.forEach((link, index) => {
      link.classList.toggle('toc-active', index === active);
      if (index === active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  window.addEventListener('scroll', highlight, { passive: true });
  window.addEventListener('resize', highlight);
  highlight();
  toc.addEventListener('click', event => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('.toc-link[href^="#"]') : null;
    const target = link && document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!target) return;
    event.preventDefault();
    closeDrawer();
    target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    target.setAttribute('tabindex', '-1');
    target.focus({ preventScroll: true });
    history.pushState(null, '', link!.hash);
  });
</script>
